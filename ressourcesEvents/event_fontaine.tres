[ext_resource type="Script" uid="uid://domwatinyle4v" path="res://script/events/EventChoice.gd" id="2_choice"]
[ext_resource type="Script" uid="uid://c0ok6gofvc76v" path="res://script/events/EventEffect.gd" id="3_effect"]
[ext_resource type="Resource" uid="uid://cdytd8w6xkwf8" path="res://ressourcesGems/ruby1.tres" id="4_ruby"]

[sub_resource type="Resource" id="Effect_heal"]
script = ExtResource("3_effect")
amount = 15
metadata/_custom_type_script = "res://script/events/EventEffect.gd"

[sub_resource type="Resource" id="Choice_drink"]
script = ExtResource("2_choice")
choice_text = "Boire l'eau"
result_text = "L'eau apaise vos blessures."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_heal")])
