[sub_resource type="Resource" id="Effect_gem"]
script = ExtResource("3_effect")
type = 4
gem = ExtResource("4_ruby")
metadata/_custom_type_script = "res://script/events/EventEffect.gd"

[sub_resource type="Resource" id="Choice_offer"]
script = ExtResource("2_choice")
choice_text = "Y jeter une offrande"
result_text = "La fontaine vous récompense."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_gem")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_leave"]
script = ExtResource("2_choice")
choice_text = "Repartir sans y toucher"
result_text = "Vous continuez votre chemin, intrigué mais prudent."
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[resource]
script = ExtResource("1_data")
event_name = "Fontaine mystérieuse"
description = "Une fontaine étrange scintille devant vous. L'eau semble presque vivante."
choices = Array[ExtResource("2_choice")]([SubResource("Choice_drink"), SubResource("Choice_offer"), SubResource("Choice_leave")])
metadata/_custom_type_script = "res://script/events/EventData.gd"
