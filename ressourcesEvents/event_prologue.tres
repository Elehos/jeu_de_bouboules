[sub_resource type="Resource" id="Choice_train_attack"]
script = ExtResource("2_choice")
choice_text = "S'entraîner à l'attaque"
result_text = "Vous apprenez un coup puissant."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_gain_superattack")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_train_defense"]
script = ExtResource("2_choice")
choice_text = "S'entraîner à la défense"
result_text = "Vous apprenez à mieux vous protéger."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_gain_defense")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_find_ruby"]
script = ExtResource("2_choice")
choice_text = "Fouiller les ruines : un éclat rouge"
result_text = "Vous trouvez un talisman rubis."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_gain_ruby")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_find_heal"]
script = ExtResource("2_choice")
choice_text = "Fouiller les ruines : une pierre chaude"
result_text = "Vous trouvez un talisman apaisant."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_gain_healgem")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_lighten"]
script = ExtResource("2_choice")
choice_text = "Alléger votre équipement"
result_text = "Vous laissez une carte derrière vous ; votre deck est plus resserré."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_remove_card")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[sub_resource type="Resource" id="Choice_gamble"]
script = ExtResource("2_choice")
choice_text = "Tenter un pari risqué"
result_text = "Un échange audacieux : une carte contre deux talismans."
effects = Array[ExtResource("3_effect")]([SubResource("Effect_remove_card_2"), SubResource("Effect_gain_ruby"), SubResource("Effect_gain_healgem")])
metadata/_custom_type_script = "res://script/events/EventChoice.gd"

[resource]
script = ExtResource("1_data")
event_name = "Avant le départ"
description = "Avant de vous enfoncer dans l'inconnu, vous avez un moment pour vous préparer."
choices = Array[ExtResource("2_choice")]([SubResource("Choice_train_attack"), SubResource("Choice_train_defense"), SubResource("Choice_find_ruby"), SubResource("Choice_find_heal"), SubResource("Choice_lighten"), SubResource("Choice_gamble")])
choices_shown = 3
metadata/_custom_type_script = "res://script/events/EventData.gd"
